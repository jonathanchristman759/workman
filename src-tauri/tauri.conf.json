{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workman",
  "version": "0.6.0",
  "identifier": "app.theworkman",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Workman",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGRkYyQTQxNTk2Qjg5QjUKUldTMWlXdFpRU3IvdjhLa1M4aWE3dk9lNUZGWGhoWjhwMGwxV1JaZ1NTSVg2aXdKbVJYbVZRVUEK",
      "endpoints": [
  "https://raw.githubusercontent.com/jonathanchristman759/workman/main/latest.json"
]
    }
  }
}